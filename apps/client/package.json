{
  "name": "moneiet-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write --config ../../.prettierrc",
      "eslint . --ignore-pattern .next --fix"
    ],
    "*.{scss,css}": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@repo/components": "workspace:*",
    "axios": "1.21.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@repo/project-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "type": "module"
}
